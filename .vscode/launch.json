  "version": "0.2.0",
  "configurations": [
    {
      "name": "aluga_comigo",
      "cwd": "mobile/aluga_comigo",
      "request": "launch",
      "type": "dart",
      "args": ["--dart-define-from-file=dart_defines.json"]
    },
    {
      "name": "aluga_comigo (profile mode)",
      "cwd": "mobile/aluga_comigo",
      "request": "launch",
      "type": "dart",
      "flutterMode": "profile",
      "args": ["--dart-define-from-file=dart_defines.json"]
    },
    {
      "name": "aluga_comigo (release mode)",
      "cwd": "mobile/aluga_comigo",
      "request": "launch",
      "type": "dart",
      "flutterMode": "release",
      "args": ["--dart-define-from-file=dart_defines.json"]
    },
    {
      "name": "aluga_comigo (Android emulator + Supabase local)",
      "cwd": "mobile/aluga_comigo",
      "request": "launch",
      "type": "dart",
      "args": ["--dart-define-from-file=dart_defines.android.json"]
    },
    {
      "name": "aluga_comigo (celular + Supabase local)",
      "cwd": "mobile/aluga_comigo",
      "request": "launch",
      "type": "dart",
      "args": ["--dart-define-from-file=dart_defines.device.json"]
    }
  ]
